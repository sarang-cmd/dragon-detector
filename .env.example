# Ecowitt integration (real data). Leave blank or use mock for local dev.
# Never commit .env.local or any file containing real keys.
ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_MAC=
DATA_SOURCE=mock

# Optional: force a mock scenario for preview/testing on localhost.
# Supported: default, storm, calm, rain, offline
MOCK_SCENARIO=default

# Optional: AI outlook via Groq (server-only). Without this the outlook
# falls back to station statistics. Get a key at https://console.groq.com
# (free tier). Never commit the real key — put it in .env.local.
GROQ_API_KEY=

# Supabase Auth (Google + email) for the learning track. Publishable key is
# public-by-design (RLS enforced); still keep real values in .env.local only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
